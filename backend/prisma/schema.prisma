generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Document {
  id           String   @id @default(uuid()) @db.Uuid
  tokenHash    String   @unique
  content      String
  isPrivate    Boolean  @default(false)
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tokenHash])
}
